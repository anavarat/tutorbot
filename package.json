{
  "name": "tutorbot-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "lint": "./node_modules/.bin/eslint apps packages --max-warnings=0",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck",
    "deploy:bot-fleet": "pnpm --filter bot-fleet deploy",
    "deploy:fleet-manager": "pnpm --filter fleet-manager deploy",
    "deploy:platform-gateway": "pnpm --filter @tutorbot/platform-gateway-worker deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.6.0",
    "typescript-eslint": "8.62.1"
  }
}
