# Build context is the repo root (wrangler image_build_context "../../..").
# Keep secrets, local env, and junk OUT of image layers.

# secrets / local env — never bake into an image
.env
.env.*
**/.env
**/.env.*
.local
**/.local
.dev.vars
**/.dev.vars
*.pem
*.key

# vcs + deps + build artifacts (reinstalled/rebuilt inside the image)
.git
.gitignore
node_modules
**/node_modules
**/dist
**/.wrangler
**/coverage
*.log

# agent / editor / OS noise
AGENTS.md
.opencode
.vscode
.idea
.DS_Store

# tests aren't needed in the runtime image
**/*.test.ts
