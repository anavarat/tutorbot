{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fleet-manager",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-05",
  // node-pg needs Node built-ins (net/tls/stream). Top-level flags ARE inherited
  // into named envs (unlike bindings), so this is declared once here.
  "compatibility_flags": ["nodejs_compat"],

  // FM reaches GW + BF over internal service bindings (GATEWAY -> platform-gateway,
  // BOT_FLEET -> bot-fleet). Worker->Worker, bypasses Access + the public edge.
  // REQUIRED same-account: a same-zone Worker fetch to an Access-gated *.workers.dev
  // host is rejected by the edge (error 1042) before Access.
  //   - GW additionally keeps a cross-zone FALLBACK: GATEWAY_BASE_URL +
  //     GW_ACCESS_* service-token secrets (used only when the binding is absent).
  //   - BF is binding-ONLY (no BOT_FLEET_BASE_URL): FM drives bot lifecycle over
  //     the binding and reads the persona catalog straight from HYPERDRIVE.
  "vars": {
    "GATEWAY_BASE_URL": "https://platform-gateway.YOUR_SUBDOMAIN.workers.dev"
  },

  // PREFERRED transport. Bindings are NOT inherited into named envs, so they are
  // re-declared verbatim in staging below (targeting the env-suffixed worker
  // names). This forms a cycle with the GW->FM (FLEET_MANAGER) binding, but
  // circular service bindings deploy fine once the sibling workers exist (bindings
  // resolve by name). dev-local targets the unsuffixed worker names:
  "services": [
    { "binding": "GATEWAY", "service": "platform-gateway" },
    { "binding": "BOT_FLEET", "service": "bot-fleet" }
  ],

  // Hyperdrive -> Supabase (session pooler, caching OFF). SAME shared config id as
  // bot-fleet: FM reads the persona catalog (GET /personas -> UI picker) DIRECTLY
  // from Postgres via listPersonaNames, instead of proxying bot-fleet. A Hyperdrive
  // config is an account-level resource, so multiple Workers may bind the same id.
  // Bindings are NOT inherited into named envs -> re-declared below.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "SUPABASE_HYPERDRIVE_ID" }],

  // Reconcile cron (stuck-saga resume + connection health sweep). Every 5 min:
  // gentle, and well clear of the 120s stuck-saga timeout so a live move is never
  // swept. Triggers are NOT inherited into named envs, so re-declared below.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Native zero-config distributed tracing. `enabled: true` above is LOGS ONLY —
    // traces need this explicit block. Inherited into named envs.
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },

  // NOTE: fleet-manager does not bind the BotFleetDO namespace. It drives bot
  // lifecycle over the BOT_FLEET service binding (bot-fleet's HTTP control routes),
  // and bot-fleet resolves the per-bot DO internally.

  // Fleet registry: source of truth for "which bots exist" (the DO has no list API).
  // Run `wrangler d1 create fleet-registry` and paste the id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fleet-registry",
      "database_id": "YOUR_DEV_D1_ID",
      "migrations_dir": "migrations"
    }
  ],

  // Named environments (same Cloudflare account). The worker `name` auto-suffixes
  // to fleet-manager-staging / fleet-manager-us-production. Bindings are NOT
  // inherited, so the service bindings, Hyperdrive and D1 registry are re-declared
  // per env. Each env targets its OWN bot-fleet / platform-gateway siblings and its
  // OWN D1 registry (separate botId namespace => no cross-env collisions).
  // `database_id`/`id` here are PLACEHOLDER TOKENS; your deploy step resolves the
  // real ids by name and substitutes them at deploy time.
  //
  // REGIONAL DEPLOYMENTS (operational isolation). `placement.region` pins the Worker
  // (and, transitively via DO first-touch, its state) to a region. staging is
  // single/AU; production fans out to us/uk/au. Each region targets its OWN
  // region-suffixed siblings (GATEWAY -> platform-gateway-<r>-production, BOT_FLEET
  // -> bot-fleet-<r>-production), its OWN Hyperdrive (PROD_<r>_HYPERDRIVE_ID) and its
  // OWN D1 registry (fleet-registry-<r>-production / PROD_<r>_D1_ID) — all
  // resolve-only tokens pinned by CI. Region map:
  //   us -> aws:us-east-1 | uk -> aws:eu-west-2 | au -> aws:ap-southeast-2
  "env": {
    "staging": {
      "placement": { "region": "aws:ap-southeast-2" },
      "vars": {
        "GATEWAY_BASE_URL": "https://platform-gateway-staging.YOUR_SUBDOMAIN.workers.dev"
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "services": [
        { "binding": "GATEWAY", "service": "platform-gateway-staging" },
        { "binding": "BOT_FLEET", "service": "bot-fleet-staging" }
      ],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "SUPABASE_HYPERDRIVE_ID_STAGING" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fleet-registry-staging",
          "database_id": "STAGING_D1_ID",
          "migrations_dir": "migrations"
        }
      ]
    },
    "us-production": {
      "placement": { "region": "aws:us-east-1" },
      "vars": {
        "GATEWAY_BASE_URL": "https://platform-gateway-us-production.YOUR_SUBDOMAIN.workers.dev"
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "services": [
        { "binding": "GATEWAY", "service": "platform-gateway-us-production" },
        { "binding": "BOT_FLEET", "service": "bot-fleet-us-production" }
      ],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "PROD_us_HYPERDRIVE_ID" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fleet-registry-us-production",
          "database_id": "PROD_us_D1_ID",
          "migrations_dir": "migrations"
        }
      ]
    },
    "uk-production": {
      "placement": { "region": "aws:eu-west-2" },
      "vars": {
        "GATEWAY_BASE_URL": "https://platform-gateway-uk-production.YOUR_SUBDOMAIN.workers.dev"
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "services": [
        { "binding": "GATEWAY", "service": "platform-gateway-uk-production" },
        { "binding": "BOT_FLEET", "service": "bot-fleet-uk-production" }
      ],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "PROD_uk_HYPERDRIVE_ID" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fleet-registry-uk-production",
          "database_id": "PROD_uk_D1_ID",
          "migrations_dir": "migrations"
        }
      ]
    },
    "au-production": {
      "placement": { "region": "aws:ap-southeast-2" },
      "vars": {
        "GATEWAY_BASE_URL": "https://platform-gateway-au-production.YOUR_SUBDOMAIN.workers.dev"
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "services": [
        { "binding": "GATEWAY", "service": "platform-gateway-au-production" },
        { "binding": "BOT_FLEET", "service": "bot-fleet-au-production" }
      ],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "PROD_au_HYPERDRIVE_ID" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fleet-registry-au-production",
          "database_id": "PROD_au_D1_ID",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
