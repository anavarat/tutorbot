{
  "name": "fleet-manager",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "tail": "wrangler tail --format pretty",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../../packages/shared build && vitest run",
    "migrate:local": "wrangler d1 migrations apply fleet-registry --local",
    "migrate:remote": "wrangler d1 migrations apply fleet-registry --remote",
    "auth": "tsx scripts/auth.ts",
    "auth:ui": "tsx scripts/auth-ui.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260704.1",
    "@hono/node-server": "2.0.4",
    "@types/pg": "^8.20.0",
    "teleproto": "1.224.1",
    "tsx": "4.19.2",
    "typescript": "^6.0.3",
    "vitest": "2.1.8",
    "wrangler": "^4.107.0"
  },
  "dependencies": {
    "@tutorbot/shared": "workspace:*",
    "hono": "^4.12.28",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
